   "source": [
    "from flask import Flask, render_template\n",
    "\n",
    "app = Flask(\"JobScrapper\")\n",
    "\n",
    "@app.route(\"/\")\n",
    "def home():\n",
    "    return render_template(\"home.html\", name=\"jo\")\n",
    "\n",
    "@app.route(\"/search\")\n",
    "def search():\n",
    "    return render_template(\"search.html\")\n",
    "\n",
    "app.run(\"0.0.0.0\")"
   ]
